<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netcoreapp3.1</TargetFrameworks>
        <Version>1.0.0-beta1</Version>
        <PackageId>SabaClub.Client</PackageId>
        <Authors>Saba Club</Authors>
        <Product>Saba Club</Product>
        <Description>The Client using to connect to Saba Club API</Description>
        <Copyright>Saba Club</Copyright>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="IdentityModel" Version="4.1.1" />
        <PackageReference Include="System.Text.Encodings.Web" Version="4.7.2" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Resources\ResultMessage.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>ResultMessage.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Resources\ResultMessage.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>ResultMessage.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>